# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID администратора (Telegram user ID) — может выдавать доступ через /grant
# Можно указать несколько через запятую: 123456789,987654321
ADMIN_IDS=312882785

# Строка подключения к PostgreSQL
# Пример: postgresql://user:password@localhost:5432/jw_talks
DATABASE_URL=postgresql://user:password@localhost:5432/jw_talks

# Название общины при первом /grant без указания общины (по умолчанию: Община 1)
DEFAULT_CONGREGATION_NAME=Община 1

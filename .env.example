# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID администратора (Telegram user ID) — может выдавать доступ через /grant
# Можно указать несколько через запятую: 123456789,987654321
ADMIN_IDS=312882785

# Строка подключения к PostgreSQL (порт 5433 — из docker-compose)
# Пример: postgresql://jwbot:jwbot@localhost:5433/jw_talks
DATABASE_URL=postgresql://jwbot:jwbot@localhost:5433/jw_talks

# Название общины при первом /grant без указания общины (по умолчанию: Община 1)
DEFAULT_CONGREGATION_NAME=Община 1
